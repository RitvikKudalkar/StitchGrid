---
// The chart sheet and its key slip (execution-plan.md §7.5). Shows an example already charted,
// so the first screen is never an empty box. With `tool`, it adds the options, the views,
// photo upload (pick, drop or paste) and the exports. The photo never leaves the device.
import { examples } from '../data/examples';
import { SITE_URL } from '../data/site';

interface Props {
  /** Cells across to start with. */
  cellsWide?: number;
  colours?: number;
  /** The full tool: options, upload and export. */
  tool?: boolean;
  /** What one cell is called. */
  unit?: string;
  /** Palette brand, shown before thread codes. */
  brand?: string;
  fabricCount?: number;
  pdfTitle?: string;
}

const { cellsWide = 64, colours = 12, tool = false, unit = 'stitches', brand = 'DMC', fabricCount = 14, pdfTitle = 'Cross stitch pattern' } = Astro.props;
const samples = examples.map((e) => ({ id: e.id, label: e.label, src: e.image.src }));
---

<div
  class:list={['workbench', { 'is-tool': tool }]}
  data-workbench
  data-cells={cellsWide}
  data-colours={colours}
  data-unit={unit}
  data-brand={brand}
  data-fabric={fabricCount}
  data-site={SITE_URL.replace('https://', '')}
  data-pdf-title={pdfTitle}
  data-samples={JSON.stringify(samples)}
  data-skeins={tool ? '' : undefined}
  data-paste={tool ? '' : undefined}
>
  <figure class="sheet chart-sheet" data-ui data-drop data-chart-sheet>
    {tool && (
      <div class="chart-bar">
        <div class="seg" role="group" aria-label="Chart view">
          <button type="button" data-mode="colour" aria-pressed="true">Colour</button>
          <button type="button" data-mode="symbols" aria-pressed="false">Symbols</button>
          <button type="button" data-mode="made" aria-pressed="false">As made</button>
        </div>
        <div class="seg" role="group" aria-label="Zoom">
          <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
          <span class="zoom-label tabular" data-zoom-label aria-live="polite">Fit</span>
          <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
        </div>
      </div>
    )}
    <div class="scroller" data-scroller>
      <canvas data-chart role="img" aria-label="Cross stitch chart of an example image"></canvas>
      <p class="tip small" data-tip hidden></p>
    </div>
    <figcaption class="sample-row">
      <span class="small muted">Example images</span>
      <div class="flex flex-wrap gap-xs" role="group" aria-label="Choose an example image">
        {samples.map((s, i) => (
          <button type="button" class="sample" data-sample={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>
        ))}
      </div>
    </figcaption>
    <p class="small status" role="status" aria-live="polite" data-status></p>
    {tool && <p class="small status" data-zoom-hint hidden>Zoom in with + to read the symbols.</p>}
    {tool && <p class="drop-hint" data-drop-hint hidden>Drop the photo to chart it</p>}
  </figure>

  <div class="side">
    {tool && (
      <form class="sheet settings" onsubmit="return false" aria-label="Pattern settings">
        <label class="btn-primary w-full upload">
          Choose a photo
          <input type="file" accept="image/*,.heic,.heif" class="sr-only" data-file />
        </label>
        <p class="small muted">Or drop or paste one on the chart. It stays on this device.</p>

        <label class="control">
          <span class="control-label">Width <output class="tabular" data-output="cellsWide">{cellsWide}</output> {unit}</span>
          <input type="range" min="30" max="300" step="1" value={cellsWide} data-option="cellsWide" />
        </label>
        <label class="control">
          <span class="control-label">Up to <output class="tabular" data-output="maxColors">{colours}</output> colours</span>
          <input type="range" min="2" max="60" step="1" value={colours} data-option="maxColors" />
        </label>
        <label class="control">
          <span class="control-label">Fabric</span>
          <select class="field" data-option="fabric">
            {[11, 14, 16, 18].map((c) => <option value={c} selected={c === fabricCount}>{c}-count Aida</option>)}
          </select>
        </label>

        <details class="more">
          <summary>More settings</summary>
          <label class="control">
            <span class="control-label">Strands</span>
            <select class="field" data-option="strands">
              <option value="1">1 strand</option>
              <option value="2" selected>2 strands</option>
              <option value="3">3 strands</option>
            </select>
          </label>
          <label class="check"><input type="checkbox" checked data-option="cleanup" /> Remove lone stitches</label>
          <label class="check"><input type="checkbox" data-option="background" /> Leave the background unstitched</label>
          <label class="check"><input type="checkbox" data-option="dither" /> Blend colours (dithering)</label>
          <label class="control">
            <span class="control-label">Brightness <output class="tabular" data-output="brightness">0</output></span>
            <input type="range" min="-50" max="50" step="1" value="0" data-option="brightness" />
          </label>
          <label class="control">
            <span class="control-label">Contrast <output class="tabular" data-output="contrast">0</output></span>
            <input type="range" min="-50" max="50" step="1" value="0" data-option="contrast" />
          </label>
        </details>
      </form>
    )}

    <aside class="slip key" aria-label="Thread key">
      <p class="title">Key</p>
      <p class="small muted mt-xxs">Point at a thread to see where it goes.</p>
      <div class:list={['key-head small', { 'with-skeins': tool }]} aria-hidden="true">
        <span></span><span>{brand}</span><span>Name</span><span>Stitches</span>{tool && <span>Skeins</span>}
      </div>
      <ul class:list={['key-list tabular', { 'with-skeins': tool }]} data-key-list></ul>
      <p class="key-total tabular" data-summary></p>
      {tool && (
        <div class="exports">
          <button type="button" class="btn-primary w-full" data-export="pdf">Download the PDF chart</button>
          <div class="export-opts">
            <label class="small">Paper
              <select class="field field-sm" data-paper>
                <option value="a4">A4</option>
                <option value="letter">Letter</option>
              </select>
            </label>
            <label class="check small"><input type="checkbox" data-bw /> Black and white</label>
          </div>
          <div class="flex gap-xs">
            <button type="button" class="btn-secondary flex-1" data-export="png">Image</button>
            <button type="button" class="btn-secondary flex-1" data-export="csv">Thread list</button>
          </div>
          <p class="small muted">Skein counts are estimates. Screen colours are close matches to real thread, not exact.</p>
        </div>
      )}
    </aside>
  </div>
</div>

<style>
  .workbench {
    display: grid;
    gap: var(--spacing-md);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 900px) {
    .workbench { grid-template-columns: minmax(0, 1fr) 340px; }
    .is-tool { grid-template-columns: minmax(0, 1fr) 380px; }
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  /* ---------- Sheet ---------- */
  .chart-sheet {
    position: relative;
    padding: 12px;
  }
  .chart-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 2px 2px 10px;
  }
  .seg {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .seg button,
  .sample {
    min-height: 40px;
    min-width: 40px;
    padding: 6px 14px;
    background: var(--color-sheet-raised);
    font-size: var(--step-small);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .seg button:active,
  .sample:active { transform: scale(0.96); }
  .seg button[aria-pressed='true'],
  .sample[aria-pressed='true'] {
    background: var(--color-sheet-ink);
    color: var(--color-sheet);
  }
  .zoom-label {
    min-width: 40px;
    text-align: center;
    font-size: var(--step-small);
  }
  .scroller {
    position: relative;
    overflow: auto;
    max-height: min(78svh, 900px);
    overscroll-behavior: contain;
  }
  .scroller canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    touch-action: pan-x pan-y pinch-zoom;
  }
  .tip {
    position: absolute;
    z-index: 2;
    max-width: 220px;
    padding: 6px 10px;
    background: var(--color-sheet-ink);
    color: var(--color-sheet);
    pointer-events: none;
  }
  .tip[hidden] { display: none; }
  .sample-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 12px 2px 0;
  }
  .status:empty { display: none; }
  .status { padding: 8px 2px 0; }
  .drop-hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-sheet) 90%, transparent);
    font-size: var(--step-lead);
  }
  .drop-hint[hidden] { display: none; }

  /* ---------- Settings ---------- */
  .settings {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
  }
  .upload { cursor: pointer; }
  .upload:focus-within {
    outline: 3px solid currentColor;
    outline-offset: -7px;
  }
  .control {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .control-label { font-weight: 500; }
  .control input[type='range'] {
    width: 100%;
    accent-color: var(--color-sheet-ink);
    min-height: 28px;
  }
  .settings .field,
  .exports .field {
    background: var(--color-sheet-raised);
    border-color: var(--color-sheet-raised);
    min-height: 44px;
  }
  .field-sm {
    width: auto;
    min-height: 40px !important;
    padding: 4px 8px;
    margin-left: 6px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    cursor: pointer;
  }
  .check input {
    width: 20px;
    height: 20px;
    accent-color: var(--color-sheet-ink);
  }
  .more summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 500;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .more[open] {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  /* ---------- Key ---------- */
  .key { padding: var(--spacing-lg); }
  .key-head,
  .key-list :global(.key-row) {
    display: grid;
    grid-template-columns: 26px 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
  }
  .with-skeins.key-head,
  .with-skeins :global(.key-row) { grid-template-columns: 26px 44px minmax(0, 1fr) auto 36px; }
  .key-head {
    margin-top: var(--spacing-md);
    padding: 0 6px 4px;
    font-weight: 500;
  }
  .key-head span:nth-child(n + 4) { text-align: right; }
  .key-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 420px;
    overflow-y: auto;
  }
  .key-list :global(.key-row) {
    width: 100%;
    min-height: 40px;
    padding: 4px 6px;
    text-align: left;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out);
  }
  .key-list :global(.key-row:hover),
  .key-list :global(.key-row[aria-pressed='true']) { background: var(--color-sheet-raised); }
  .key-list :global(.key-sym) {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
  }
  .key-list :global(.key-name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .key-list :global(.key-count),
  .key-list :global(.key-skeins) { text-align: right; }
  .key-total {
    margin-top: var(--spacing-md);
    padding: 10px 12px;
    background: var(--color-sheet-ink);
    color: var(--color-sheet);
  }
  .exports {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-lg);
  }
  .export-opts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
</style>

<script>
  import { initWorkbench } from '../scripts/workbench';

  document.querySelectorAll<HTMLElement>('[data-workbench]').forEach(initWorkbench);
</script>
