---
// The money page (execution-plan.md §1, §5). Tool first, then the content.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GuideList from '../components/GuideList.astro';
import Workbench from '../components/Workbench.astro';
import { archive } from '../data/archive';
import { examples } from '../data/examples';
import { guides } from '../data/guides';
import { faqSchema, toolSchemas, type Faq } from '../data/schema';
import { toolBySlug } from '../data/tools';

const tool = toolBySlug('cross-stitch-pattern-maker');
const title = 'Cross Stitch Pattern Maker: Free, From Your Photo';
const description = 'Turn any photo into a printable cross stitch pattern with a DMC thread list. Free, private and no sign-up: your photo never leaves your device.';

// What works for each example, shown beside its photo.
const advice: Record<string, { settings: string; text: string }> = {
  cat: { settings: '100 stitches, 24 colours', text: 'Fur needs more colours than you expect: browns and creams that look alike on screen are different threads. Fill the frame with the face, and the eyes will carry the likeness.' },
  flower: { settings: '80 stitches, 16 colours, background left unstitched', text: 'A single bloom on a plain background is the easiest photo to chart. Leave the background unstitched and the flower sits on bare Aida, which saves hours of filling in grey.' },
  house: { settings: '120 stitches, 30 colours', text: 'Busy scenes need width. Below about 100 stitches, leaves and brickwork turn to noise. Crop to the part you love, here the door and its wreath, before you chart it.' },
  portrait: { settings: '150 stitches, 36 colours', text: 'Faces are the hardest subject: small shifts in skin tone matter. Use a well-lit photo, go wide, and raise the contrast a little if the face looks flat.' },
};

const counts = [11, 14, 16, 18];
const widths = [50, 100, 150, 200];
const strandsFor: Record<number, string> = { 11: '3 strands', 14: '2 strands', 16: '2 strands', 18: '1 or 2 strands' };
const fabrics = counts.map((count) => ({
  count,
  rows: widths.map((w) => ({ w, inches: (w / count).toFixed(1), cm: ((w / count) * 2.54).toFixed(1) })),
}));

const itinerary = [
  { when: 'At your desk', rows: [['Choose a clear photo', '10 sec'], ['Set the width and colours', '1 min'], ['Download the PDF chart', '5 sec']] },
  { when: 'At the shop', rows: [['Buy the threads on the key', 'one trip'], ['Buy Aida a little bigger than the chart', '3 in extra']] },
  { when: 'At the hoop', rows: [['Fold the fabric in four to find the centre', '1 min'], ['Stitch outwards from the centre arrows', 'your pace']] },
];

const faqs: Faq[] = [
  { question: 'Is this cross stitch pattern maker free?', answer: 'Yes. There is no sign-up, no trial and no watermark. You can download the PDF chart, the image and the thread list as often as you like.' },
  { question: 'Are my photos uploaded?', answer: 'No. The pattern is made inside your browser, on your own device. Your photo is never sent to a server, so nobody else can see it.' },
  { question: 'How many colours should I use?', answer: 'Between 15 and 30 suits most photos. Simple subjects on plain backgrounds need fewer; faces, fur and landscapes need more. Every extra colour is another skein to buy and another thread change.' },
  { question: 'What size will my finished piece be?', answer: 'Divide the number of stitches by the fabric count. A chart 100 stitches wide is about 7.1 inches (18 cm) on 14-count Aida. The tool shows the finished size as you change the settings.' },
  { question: 'Can I use Anchor threads?', answer: 'The key lists DMC numbers, the most widely sold thread. Anchor and other brands publish conversion charts from DMC numbers. An Anchor palette may be added later.' },
  { question: 'Why does my pattern look different from my photo?', answer: 'A chart has a fixed number of squares and a limited set of real threads, so fine detail and subtle shading are simplified. Use a wider chart, more colours or a cropped photo to keep more detail.' },
  { question: 'Can I sell what I stitch from it?', answer: 'Yes, if the photo is yours. Charts made here belong to you. If the photo was taken by someone else, ask them first.' },
];

const toolGuides = guides.filter((g) => g.tool === tool.slug);
---

<Layout
  title={title}
  description={description}
  thread={{ color: tool.thread, ink: tool.threadInk }}
  schema={[...toolSchemas({ path: `/${tool.slug}`, name: tool.name, description }), faqSchema(faqs)]}
>
  <Header />

  <main id="main" tabindex="-1" class="flex-1 w-full outline-none">
    <section class="wrap pt-lg">
      <h1 class="display-xl tool-title">{tool.name}</h1>
      <p class="lead mt-sm mb-xl max-w-[52ch]">Turn any photo into a printable chart with a DMC thread list. Free, private, no sign-up. Your photo stays on this device.</p>
      <div class="thread-field bench">
        <Workbench cellsWide={100} colours={20} tool unit={tool.unit} />
      </div>
    </section>

    <section class="wrap section-gap examples" aria-labelledby="examples-title">
      <div class="examples-plate">
        {examples.map((e, i) => (
          <Image src={e.image} alt={e.alt} widths={[480, 960]} sizes="(min-width: 900px) 45vw, 100vw" class="plate-img" data-plate={e.id} hidden={i !== 0} />
        ))}
      </div>
      <div class="examples-text">
        <div class="example-tabs" role="tablist" aria-label="Example photos">
          {examples.map((e, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-example={e.id} class="example-tab">
              <Image src={e.image} alt="" widths={[120]} sizes="60px" class="tab-thumb" />
              <span>{e.label}</span>
            </button>
          ))}
        </div>
        <div class="example-body">
          <h2 id="examples-title" class="display-lg">What makes a good photo</h2>
          {examples.map((e, i) => (
            <div data-advice={e.id} hidden={i !== 0} class="mt-lg">
              <p class="title">{advice[e.id].settings}</p>
              <p class="mt-sm max-w-[44ch]">{advice[e.id].text}</p>
            </div>
          ))}
        </div>
        <div class="example-actions">
          <button type="button" class="action-cell action-ink" data-chart-example>Chart this example</button>
          <button type="button" class="action-cell action-tone" data-open-file>Use your own photo</button>
        </div>
      </div>
    </section>

    <section class="how-field section-gap">
      <div class="wrap how">
        <div class="how-text article">
          <h2 class="display-lg">How to turn a photo into a cross stitch pattern</h2>
          <p class="lead">Choose a photo above or drop one on the chart. The pattern appears in about a second, already matched to DMC threads.</p>
          <p>Set the <strong>width</strong> first: it decides how big the finished piece is and how much detail survives. Then set the <strong>number of colours</strong>. Fewer colours make a calmer chart that is quicker to stitch; more colours keep shading in faces and fur. Point at any thread in the key to see where it goes on the chart.</p>
          <p>When it looks right, download the PDF. It has a cover with a preview, the key with DMC numbers, stitch counts and skein estimates, and the chart split across pages with row and column numbers. Print it on A4 or Letter, in colour or in black-and-white symbols to save ink.</p>
        </div>
        <div class="slip itinerary tabular">
          {itinerary.map((g) => (
            <div class="itinerary-group">
              <p class="itinerary-when">{g.when}</p>
              {g.rows.map(([what, time]) => (
                <p class="itinerary-row"><span>{what}</span><span class="leader" aria-hidden="true"></span><span>{time}</span></p>
              ))}
            </div>
          ))}
          <p class="itinerary-result"><span>You hold a chart and a thread list</span><span>2 min</span></p>
        </div>
      </div>
    </section>

    <section class="wrap section-gap fabric" aria-labelledby="fabric-title">
      <h2 id="fabric-title" class="giant">Fabric</h2>
      <p class="mt-md">Aida is sold by count: the number of stitches in one inch. The same chart comes out smaller on a higher count. Open a count to see finished sizes.</p>
      <div class="bars tabular">
        {fabrics.map((f, i) => (
          <details class="bar" open={i === 1}>
            <summary><span>{f.count}-count Aida, usually {strandsFor[f.count]}</span><span class="plus" aria-hidden="true"></span></summary>
            <table class="bar-table">
              <caption class="sr-only">Finished width on {f.count}-count Aida</caption>
              <thead><tr><th scope="col">Chart width</th><th scope="col">Inches</th><th scope="col">Centimetres</th></tr></thead>
              <tbody>
                {f.rows.map((r) => (
                  <tr><td>{r.w} stitches</td><td>{r.inches} in</td><td>{r.cm} cm</td></tr>
                ))}
              </tbody>
            </table>
          </details>
        ))}
      </div>
      <p class="mt-lg">Buy your fabric with 2–3 inches (5–8 cm) spare on every side, so there's room to frame it or fit it in a hoop. The <a href="/guides/aida-fabric-count-explained" class="link">Aida count guide</a> explains which count suits which project.</p>
    </section>

    <section class="wrap section-gap reading">
      <div class="article">
        <h2 class="display-lg">Choosing the size and number of colours</h2>
        <p>Width and colours pull in opposite directions from your patience. A wider chart keeps more detail but takes longer to stitch; more colours keep subtle shading but mean more skeins and more thread changes. These are good starting points:</p>
        <div class="table-wrap">
          <table class="data-table tabular">
            <thead><tr><th scope="col">Subject</th><th scope="col">Width</th><th scope="col">Colours</th><th scope="col">On 14-count</th></tr></thead>
            <tbody>
              <tr><td>Small motif, bookmark or card</td><td>30–60</td><td>6–12</td><td>2–4 in</td></tr>
              <tr><td>Pet portrait</td><td>90–150</td><td>20–35</td><td>6.5–11 in</td></tr>
              <tr><td>Flower or object on a plain background</td><td>70–120</td><td>12–24</td><td>5–8.5 in</td></tr>
              <tr><td>Human portrait</td><td>120–200</td><td>30–50</td><td>8.5–14 in</td></tr>
              <tr><td>Landscape or busy scene</td><td>150–250</td><td>30–50</td><td>11–18 in</td></tr>
            </tbody>
          </table>
        </div>
        <p>Turn on <strong>Remove lone stitches</strong> (it's on by default): single stitches in a sea of another colour are slow to sew and barely change the picture. Leave <strong>Blend colours</strong> off unless you want a painterly, speckled look; it scatters colours to imitate shades that aren't in the key.</p>

        <h2 class="display-lg">Tips for photos that make good patterns</h2>
        <ul>
          <li><strong>One clear subject.</strong> Crop away everything you won't miss. The subject should fill most of the frame.</li>
          <li><strong>Even daylight.</strong> Harsh shadows and flash glare become hard-edged blotches of dark and white thread.</li>
          <li><strong>A plain background.</strong> It can be left unstitched, which saves hours and makes the subject stand out.</li>
          <li><strong>Strong contrast.</strong> A dark cat on a dark sofa will merge into one colour. If the chart looks flat, raise the contrast in More settings.</li>
          <li><strong>Sharp focus where it matters.</strong> Eyes in a portrait, petals in a flower. Blur elsewhere is fine.</li>
        </ul>

        <h2 class="display-lg">Printing and reading your chart</h2>
        <p>Each square on the chart is one full cross stitch, and its symbol tells you the thread from the key. Bold lines mark every 10 stitches so you can count quickly, and the arrows on the edges point to the centre. Fold your fabric in four, crease it lightly, and start stitching from where the creases meet.</p>
        <p>Big charts are split across several pages. Each page says which columns and rows it holds and shows a small map of where it sits in the whole chart. The <strong>black and white</strong> option prints symbols only, which is easier to read under a lamp and much kinder to your ink.</p>
        <figure class="reading-plate">
          <Image src={archive.berlinChart.image} alt={archive.berlinChart.alt} widths={[480, 960]} sizes="(min-width: 900px) 40vw, 100vw" />
          <figcaption class="small mt-xs">Charts have worked this way for 200 years: one painted square for each stitch. <a href={archive.berlinChart.source} class="link">{archive.berlinChart.credit}</a></figcaption>
        </figure>

        <h2 class="display-lg">How StitchGrid compares</h2>
        <p>There are good tools for this already, and the best one depends on what you need. Here is an honest summary, based on how each one generally works; check their sites for current details.</p>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th scope="col">Tool</th><th scope="col">Where your photo goes</th><th scope="col">Cost</th><th scope="col">Best for</th></tr></thead>
            <tbody>
              <tr><td>StitchGrid</td><td>Stays on your device</td><td>Free</td><td>A private, quick chart with a thread list</td></tr>
              <tr><td>Online converters (such as Pic2Pat)</td><td>Uploaded to their server</td><td>Free</td><td>A quick chart when privacy doesn't matter</td></tr>
              <tr><td>Online editors (such as Stitch Fiddle)</td><td>Uploaded; saved to an account</td><td>Free, with paid extras</td><td>Editing a chart stitch by stitch</td></tr>
              <tr><td>Desktop software (such as PCStitch or WinStitch)</td><td>Stays on your computer</td><td>One-off purchase</td><td>Designers who sell patterns</td></tr>
              <tr><td>Photoshop or GIMP</td><td>Stays on your computer</td><td>Varies</td><td>People who already know them; no thread matching</td></tr>
            </tbody>
          </table>
        </div>
        <p>Where StitchGrid falls short today: you can't yet edit single stitches, and it makes full cross stitches only, with no backstitch outlines or fractional stitches. If you need those, a dedicated editor is the better choice.</p>
      </div>
    </section>

    <section class="faq-field section-gap" aria-labelledby="faq-title">
      <div class="wrap faq">
        <h2 id="faq-title" class="display-lg">Questions</h2>
        <div class="faq-text">
          {faqs.map((f) => (
            <p><strong>{f.question}</strong> {f.answer}</p>
          ))}
        </div>
      </div>
    </section>

    {toolGuides.length > 0 && (
      <section class="wrap section-gap guides-list" aria-labelledby="guides-title">
        <h2 id="guides-title" class="display-lg">Guides</h2>
        <GuideList guides={toolGuides} />
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .tool-title { font-size: clamp(3rem, 1rem + 7vw, 7.5rem); }
  .bench { padding: clamp(8px, 1.5vw, 20px); }

  /* ---------- Examples: square plate, spare text ---------- */
  .examples {
    display: grid;
    gap: var(--spacing-xl);
  }
  @media (min-width: 900px) {
    .examples { grid-template-columns: 1fr 1fr; min-height: 80svh; align-items: stretch; }
  }
  .examples-plate {
    align-self: start;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .plate-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plate-img[hidden] { display: none; }
  .examples-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-xl);
  }
  .example-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .example-tab {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 14px 4px 4px;
    background: var(--color-mat-raised);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .example-tab:active { transform: scale(0.97); }
  .example-tab[aria-selected='true'] {
    background: var(--color-thread);
    color: var(--color-thread-ink);
  }
  .tab-thumb {
    width: 44px;
    height: 44px;
    object-fit: cover;
  }
  [data-advice][hidden] { display: none; }
  .example-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .action-cell {
    min-height: 72px;
    padding: 12px 18px;
    text-align: left;
    font-weight: 500;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .action-cell:active { transform: scale(0.98); }
  .action-ink { background: var(--color-text); color: var(--color-mat); }
  .action-tone { background: var(--color-mat-raised); }
  @media (max-width: 899px) {
    .action-cell { min-height: 60px; }
    .example-actions { grid-template-columns: 1fr; }
  }

  /* ---------- How it works: itinerary on a slip ---------- */
  .how-field {
    background: var(--color-thread);
    color: var(--color-thread-ink);
    padding-block: clamp(72px, 9vw, 144px);
  }
  .how {
    display: grid;
    gap: var(--spacing-3xl);
  }
  @media (min-width: 1000px) {
    .how { grid-template-columns: 6fr 5fr; align-items: start; }
  }
  /* A long keyword heading: sized to stay on two lines in its column. */
  .how-text h2 {
    font-size: clamp(2.25rem, 0.8rem + 3.4vw, 4rem);
    margin-bottom: var(--spacing-lg);
  }
  .itinerary {
    width: 100%;
    max-width: 480px;
    padding: var(--spacing-lg) var(--spacing-lg) calc(var(--spacing-lg) + 12px);
    justify-self: center;
  }
  .itinerary-group + .itinerary-group { margin-top: 28px; }
  .itinerary-when {
    font-weight: 500;
    font-size: var(--step-lead);
    margin-bottom: 6px;
  }
  .itinerary-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-block: 4px;
  }
  .itinerary-row > span:last-child,
  .itinerary-result > span:last-child { white-space: nowrap; }
  .leader {
    flex: 1;
    min-width: 24px;
    border-bottom: 4px dotted currentColor;
    opacity: 0.45;
  }
  .itinerary-result {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 28px;
    padding: 12px 14px;
    background: var(--color-sheet-ink);
    color: var(--color-sheet);
  }

  /* ---------- Fabric: giant word, filled bars ---------- */
  .fabric {
    max-width: 640px;
    container-type: inline-size;
  }
  .giant {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 44cqw;
    line-height: 0.8;
    letter-spacing: -0.02em;
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 20px;
  }
  .bar { background: var(--color-mat-raised); }
  .bar summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 0 18px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .bar summary::-webkit-details-marker { display: none; }
  .plus {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    transition: transform 200ms var(--ease-out);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    inset: 7px 0;
    background: currentColor;
  }
  .plus::after { transform: rotate(90deg); }
  .bar[open] .plus { transform: rotate(45deg); }
  /* No box at all while closed, so hidden rows are never measured as page text. */
  .bar:not([open]) .bar-table { display: none; }
  .bar-table {
    width: 100%;
    margin: 0 0 8px;
    border-collapse: collapse;
  }
  .bar-table th,
  .bar-table td {
    padding: 8px 18px;
    text-align: right;
  }
  .bar-table th:first-child,
  .bar-table td:first-child { text-align: left; }
  .bar-table th { font-weight: 500; }

  /* ---------- Reading column ---------- */
  .reading .article h2 { margin-bottom: 0.4em; }
  .reading .article h2:first-child { margin-top: 0; }
  .table-wrap { overflow-x: auto; }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-small);
  }
  .data-table th,
  .data-table td {
    padding: 10px 12px 10px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-mat-raised);
  }
  .data-table th { font-weight: 500; }
  .reading-plate img {
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
  }

  /* ---------- FAQ: answers as reading text ---------- */
  .faq-field {
    background: var(--color-mat-raised);
    padding-block: clamp(72px, 9vw, 144px);
  }
  .faq {
    display: grid;
    gap: var(--spacing-2xl);
  }
  @media (min-width: 900px) {
    .faq { grid-template-columns: 3fr 9fr; }
  }
  .faq-text p + p { margin-top: 20px; }
  .faq-text strong { font-weight: 500; }
  @media (min-width: 900px) {
    .faq-text {
      columns: 2;
      column-gap: 56px;
    }
    .faq-text p { break-inside: avoid; }
  }

  /* ---------- Guides ---------- */
  .guides-list { margin-bottom: var(--spacing-section); }
</style>

<script>
  // Example tabs swap the plate and its advice; the actions chart it or open the file picker.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-example]')];
  let current = tabs[0]?.dataset.example;
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      current = tab.dataset.example!;
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll<HTMLElement>('[data-plate]').forEach((el) => (el.hidden = el.dataset.plate !== current));
      document.querySelectorAll<HTMLElement>('[data-advice]').forEach((el) => (el.hidden = el.dataset.advice !== current));
    }),
  );
  document.querySelector('[data-chart-example]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>(`[data-sample="${current}"]`)?.click();
    document.querySelector('[data-chart-sheet]')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
  document.querySelector('[data-open-file]')?.addEventListener('click', () => {
    document.querySelector<HTMLInputElement>('[data-file]')?.click();
  });
</script>
