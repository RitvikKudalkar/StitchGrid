---
// The money page (execution-plan.md §1, §5). Tool first, then the content.
import { Image } from 'astro:assets';
import ToolLayout from '../layouts/ToolLayout.astro';
import ExamplePlate from '../components/tool/ExamplePlate.astro';
import GiantBars from '../components/tool/GiantBars.astro';
import ItinerarySlip from '../components/tool/ItinerarySlip.astro';
import ReadingColumn from '../components/tool/ReadingColumn.astro';
import { archive } from '../data/archive';
import type { Faq } from '../data/schema';

const title = 'Cross Stitch Pattern Maker: Free, From Your Photo';
const description = 'Turn any photo into a printable cross stitch pattern with a DMC thread list. Free, private and no sign-up: your photo never leaves your device.';

// What works for each example, shown beside its photo.
const advice = {
  cat: { settings: '100 stitches, 24 colours', text: 'Fur needs more colours than you expect: browns and creams that look alike on screen are different threads. Fill the frame with the face, and the eyes will carry the likeness.' },
  flower: { settings: '80 stitches, 16 colours, background left unstitched', text: 'A single bloom on a plain background is the easiest photo to chart. Leave the background unstitched and the flower sits on bare Aida, which saves hours of filling in grey.' },
  house: { settings: '120 stitches, 30 colours', text: 'Busy scenes need width. Below about 100 stitches, leaves and brickwork turn to noise. Crop to the part you love, here the door and its wreath, before you chart it.' },
  portrait: { settings: '150 stitches, 36 colours', text: 'Faces are the hardest subject: small shifts in skin tone matter. Use a well-lit photo, go wide, and raise the contrast a little if the face looks flat.' },
};

const strandsFor: Record<number, string> = { 11: '3 strands', 14: '2 strands', 16: '2 strands', 18: '1 or 2 strands' };
const fabrics = [11, 14, 16, 18].map((count) => ({
  label: `${count}-count Aida, usually ${strandsFor[count]}`,
  caption: `Finished width on ${count}-count Aida`,
  head: ['Chart width', 'Inches', 'Centimetres'],
  rows: [50, 100, 150, 200].map((w) => [`${w} stitches`, `${(w / count).toFixed(1)} in`, `${((w / count) * 2.54).toFixed(1)} cm`]),
}));

const faqs: Faq[] = [
  { question: 'Is this cross stitch pattern maker free?', answer: 'Yes. There is no sign-up, no trial and no watermark. You can download the PDF chart, the image and the thread list as often as you like.' },
  { question: 'Are my photos uploaded?', answer: 'No. The pattern is made inside your browser, on your own device. Your photo is never sent to a server, so nobody else can see it.' },
  { question: 'How many colours should I use?', answer: 'Between 15 and 30 suits most photos. Simple subjects on plain backgrounds need fewer; faces, fur and landscapes need more. Every extra colour is another skein to buy and another thread change.' },
  { question: 'What size will my finished piece be?', answer: 'Divide the number of stitches by the fabric count. A chart 100 stitches wide is about 7.1 inches (18 cm) on 14-count Aida. The tool shows the finished size as you change the settings.' },
  { question: 'Can I change single stitches?', answer: 'Yes. Press Edit above the chart, pick a thread in the key and paint on the chart. You can also replace every stitch of one colour, merge a colour into its closest neighbour, and undo.' },
  { question: 'Can I use Anchor threads?', answer: 'The key lists DMC numbers, the most widely sold thread. Anchor and other brands publish conversion charts from DMC numbers. An Anchor palette may be added later.' },
  { question: 'Can I sell what I stitch from it?', answer: 'Yes, if the photo is yours. Charts made here belong to you. If the photo was taken by someone else, ask them first.' },
];
---

<ToolLayout
  slug="cross-stitch-pattern-maker"
  craft="cross-stitch"
  title={title}
  description={description}
  lead="Turn any photo into a printable chart with a DMC thread list. Free, private, no sign-up. Your photo stays on this device."
  faqs={faqs}
>
  <ExamplePlate heading="What makes a good photo" advice={advice} />

  <ItinerarySlip
    groups={[
      { when: 'At your desk', rows: [['Choose a clear photo', '10 sec'], ['Set the width and colours', '1 min'], ['Download the PDF chart', '5 sec']] },
      { when: 'At the shop', rows: [['Buy the threads on the key', 'one trip'], ['Buy Aida a little bigger than the chart', '3 in extra']] },
      { when: 'At the hoop', rows: [['Fold the fabric in four to find the centre', '1 min'], ['Stitch outwards from the centre arrows', 'your pace']] },
    ]}
    result={['You hold a chart and a thread list', '2 min']}
  >
    <h2 class="display-lg">How to turn a photo into a cross stitch pattern</h2>
    <p class="lead">Choose a photo above or drop one on the chart. The pattern appears in about a second, already matched to DMC threads.</p>
    <p>Set the <strong>width</strong> first: it decides how big the finished piece is and how much detail survives. Then set the <strong>number of colours</strong>. Fewer colours make a calmer chart that is quicker to stitch; more colours keep shading in faces and fur. Point at any thread in the key to see where it goes on the chart.</p>
    <p>When it looks right, download the PDF. It has a cover with a preview, the key with DMC numbers, stitch counts and skein estimates, and the chart split across pages with row and column numbers. Print it on A4 or Letter, in colour or in black-and-white symbols to save ink.</p>
  </ItinerarySlip>

  <GiantBars word="Fabric" intro="Aida is sold by count: the number of stitches in one inch. The same chart comes out smaller on a higher count. Open a count to see finished sizes." bars={fabrics} open={1}>
    <p>Buy your fabric with 2–3 inches (5–8 cm) spare on every side, so there's room to frame it or fit it in a hoop. The <a href="/guides/aida-fabric-count-explained">Aida count guide</a> explains which count suits which project.</p>
  </GiantBars>

  <ReadingColumn>
    <h2 class="display-lg">Choosing the size and number of colours</h2>
    <p>Width and colours pull in opposite directions from your patience. A wider chart keeps more detail but takes longer to stitch; more colours keep subtle shading but mean more skeins and more thread changes. These are good starting points:</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Subject</th><th scope="col">Width</th><th scope="col">Colours</th><th scope="col">On 14-count</th></tr></thead>
        <tbody>
          <tr><td>Small motif, bookmark or card</td><td>30–60</td><td>6–12</td><td>2–4 in</td></tr>
          <tr><td>Pet portrait</td><td>90–150</td><td>20–35</td><td>6.5–11 in</td></tr>
          <tr><td>Flower or object on a plain background</td><td>70–120</td><td>12–24</td><td>5–8.5 in</td></tr>
          <tr><td>Human portrait</td><td>120–200</td><td>30–50</td><td>8.5–14 in</td></tr>
          <tr><td>Landscape or busy scene</td><td>150–250</td><td>30–50</td><td>11–18 in</td></tr>
        </tbody>
      </table>
    </div>
    <p>Turn on <strong>Remove lone stitches</strong> (it's on by default): single stitches in a sea of another colour are slow to sew and barely change the picture. Leave <strong>Blend colours</strong> off unless you want a painterly, speckled look; it scatters colours to imitate shades that aren't in the key.</p>
    <p>If one area looks wrong, press <strong>Edit</strong> above the chart. Paint single stitches with any thread from the key, replace every stitch of one colour with another, or merge a colour you don't want into its closest neighbour.</p>

    <h2 class="display-lg">Tips for photos that make good patterns</h2>
    <ul>
      <li><strong>One clear subject.</strong> Crop away everything you won't miss. The subject should fill most of the frame.</li>
      <li><strong>Even daylight.</strong> Harsh shadows and flash glare become hard-edged blotches of dark and white thread.</li>
      <li><strong>A plain background.</strong> It can be left unstitched, which saves hours and makes the subject stand out.</li>
      <li><strong>Strong contrast.</strong> A dark cat on a dark sofa will merge into one colour. If the chart looks flat, raise the contrast in More settings.</li>
      <li><strong>Sharp focus where it matters.</strong> Eyes in a portrait, petals in a flower. Blur elsewhere is fine.</li>
    </ul>

    <h2 class="display-lg">Printing and reading your chart</h2>
    <p>Each square on the chart is one full cross stitch, and its symbol tells you the thread from the key. Bold lines mark every 10 stitches so you can count quickly, and the arrows on the edges point to the centre. Fold your fabric in four, crease it lightly, and start stitching from where the creases meet.</p>
    <p>Big charts are split across several pages. Each page says which columns and rows it holds and shows a small map of where it sits in the whole chart. The <strong>black and white</strong> option prints symbols only, which is easier to read under a lamp and much kinder to your ink.</p>
    <figure>
      <Image src={archive.berlinChart.image} alt={archive.berlinChart.alt} widths={[480, 960]} sizes="(min-width: 900px) 40vw, 100vw" />
      <figcaption class="small mt-xs">Charts have worked this way for 200 years: one painted square for each stitch. <a href={archive.berlinChart.source} class="link">{archive.berlinChart.credit}</a></figcaption>
    </figure>

    <h2 class="display-lg">How StitchGrid compares</h2>
    <p>There are good tools for this already, and the best one depends on what you need. Here is an honest summary, based on how each one generally works; check their sites for current details.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Tool</th><th scope="col">Where your photo goes</th><th scope="col">Cost</th><th scope="col">Best for</th></tr></thead>
        <tbody>
          <tr><td>StitchGrid</td><td>Stays on your device</td><td>Free</td><td>A private, quick chart with a thread list</td></tr>
          <tr><td>Online converters (such as Pic2Pat)</td><td>Uploaded to their server</td><td>Free</td><td>A quick chart when privacy doesn't matter</td></tr>
          <tr><td>Online editors (such as Stitch Fiddle)</td><td>Uploaded; saved to an account</td><td>Free, with paid extras</td><td>Designing and editing charts in depth</td></tr>
          <tr><td>Desktop software (such as PCStitch or WinStitch)</td><td>Stays on your computer</td><td>One-off purchase</td><td>Designers who sell patterns</td></tr>
          <tr><td>Photoshop or GIMP</td><td>Stays on your computer</td><td>Varies</td><td>People who already know them; no thread matching</td></tr>
        </tbody>
      </table>
    </div>
    <p>Where StitchGrid falls short today: it makes full cross stitches only, with no backstitch outlines or fractional stitches, and it doesn't save charts between visits. If you need those, a dedicated editor is the better choice.</p>
  </ReadingColumn>
</ToolLayout>
