{
  "name": "patternsquare",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the worker first so www./http:// requests are 301'd before assets are served.
    "run_worker_first": true,
    // Serve /page and redirect /page/ -> /page, matching the canonical URLs.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
