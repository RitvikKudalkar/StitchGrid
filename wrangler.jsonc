{
  "name": "patternsquare",
  "compatibility_date": "2026-10-25",
  // The site lives on its own domain; the workers.dev preview is off.
  "workers_dev": false,
  // Cloudflare creates the DNS records for these. www is redirected to the bare domain by the worker.
  "routes": [
    { "pattern": "patternsquare.com", "custom_domain": true },
    { "pattern": "www.patternsquare.com", "custom_domain": true }
  ],
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the worker first so www./http:// requests are 301'd before assets are served.
    "run_worker_first": true,
    // Serve /page and redirect /page/ -> /page, matching the canonical URLs.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
